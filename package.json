{
  "name": "samyang-market-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node server/analysis.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:offline": "tsc -b && vite build --mode offline",
    "test:static": "node scripts/static-smoke.mjs",
    "deploy:pages": "npm run build:pages && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/noto-sans-kr": "^5.2.7",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "undici": "7.16.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
