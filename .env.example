# Server-only configuration. No real credentials belong in this file.
# Copy to the ignored .env file if needed; the server does not auto-load it.
# Use: node --env-file=.env --run dev
# Leave MI_LLM_API_KEY empty to use the rule-based local analysis mode.
MI_LLM_API_KEY=
MI_LLM_BASE_URL=https://api.openai.com/v1
MI_LLM_MODEL=gpt-4.1-mini
PORT=3001
